{
  "name": "@guarani/di",
  "version": "1.1.1",
  "description": "Dependency Injection Framework for Guarani.",
  "license": "MIT",
  "homepage": "https://github.com/guaraniframework/node-di#readme",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "prepare": "pnpm exec husky",
    "test": "pnpm exec jest",
    "release": "pnpm run build && pnpm pack --pack-destination release && pnpm publish --access public",
    "postpublish": "rm -rf dist release"
  },
  "bugs": {
    "url": "https://github.com/guaraniframework/node-di/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/guaraniframework/node-di.git"
  },
  "author": {
    "name": "Revensky",
    "url": "https://github.com/revensky"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "inversion",
    "control",
    "dependency",
    "injection",
    "container"
  ],
  "dependencies": {
    "@guarani/primitives": "^1.1.5",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "jest-extended": "^7.0.0",
    "jest-util": "^30.5.1",
    "jsonc-eslint-parser": "^3.3.0",
    "lint-staged": "^17.6.0",
    "neostandard": "^0.14.1",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
